{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "MaxStoryCount": 200,
    "MaxConcurrency": 16
  },
  "Cache": {
    "StoryIdsTtlSeconds": 120,
    "StoryItemTtlSeconds": 300
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  }
}
